&CONTROL
   calculation      = 'scf'
   outdir           = './tmp'
   prefix           = 'graphene'
   pseudo_dir       = '../pseudos'
/
&SYSTEM
   ecutwfc          = 60
   ecutrho          = 240
   occupations      = 'smearing'
   degauss          = 0.02
   smearing         = 'gaussian'
   ntyp             = 1
   nat              = 2
   ibrav            = 0
/
&ELECTRONS
   conv_thr         = 1e-08
/
&IONS
/
&CELL
/
&FCP
/
&RISM
/
